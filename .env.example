# SaaS CRM — переменные окружения
# Скопировать в .env и заполнить. .env НЕ коммитим.

NODE_ENV=production
PORT=3000

# === Postgres ===
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=detail_user
DB_PASSWORD=         # openssl rand -hex 24
DB_NAME=detail_crm
# Managed-кластер TimeWeb (crmilia, тот же что у прода ugtsrm.ru).
# CA-сертификат переиспользуем с прода — он один на кластер:
DB_CA_CERT_PATH=/var/www/saas-crm/ca.crt

# === Сессии ===
SESSION_TTL_HOURS=720       # абсолютный TTL: 30 дней по умолчанию
SESSION_IDLE_HOURS=336      # idle-timeout: 14 дней с последнего использования
SESSION_COOKIE_NAME=sid
SESSION_COOKIE_DOMAIN=      # пример: example.com (опционально, домен cookie)
SESSION_COOKIE_SECURE=true  # production: true (HTTPS), dev: false

# === Приложение ===
# APP_ORIGIN — публичный origin сайта, используется для построения reset-links
# в письмах/TG. Должен включать схему. Пример: https://example.com
APP_ORIGIN=
# CORS_ORIGINS — список allowed-origins для cross-origin запросов с фронта,
# через запятую. Если фронт на том же домене — оставь пустым.
CORS_ORIGINS=

# === Продамус ===
# Получить в кабинете Продамуса: Настройки → API → Секретный ключ
PRODAMUS_SECRET_KEY=
# Базовый URL магазина для REST-вызовов (setActivity и пр.) — без / на конце.
# Пример: https://your-shop.payform.ru
# Если не задан — «Отменить подписку» обойдётся локальным флагом + защитой
# webhook'а (paid_after_cancel → бонус-баланс), но рекуррент в Prodamus
# не будет выключен по API.
PRODAMUS_API_BASE=

# === Telegram бот ===
# Получить у @BotFather: /newbot → API token
TELEGRAM_BOT_TOKEN=
# Секрет для X-Telegram-Bot-Api-Secret-Token (если используется webhook-режим
# Telegram). В polling-режиме (по дефолту) не нужен. Сгенерировать:
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# === Бэкапы ===
BACKUP_DIR=/var/backups/saas-crm
BACKUP_RETENTION_DAYS=14

# === Воронка прогрева в Telegram ===
# Тайминги воронки захардкожены (T+1/+5/+14/+24/+29 от access_until).
# Эти переменные нужны только для прогона/отладки.
# FUNNEL_DRY_RUN=true — cron-функция воронки логирует «что бы отправил»,
# но не шлёт реальные сообщения и не пишет в funnel_events.
FUNNEL_DRY_RUN=

# === Retention (удаление брошенных студий) ===
# Через сколько дней после истечения access_until удаляем студию (default 30)
RETENTION_AFTER_EXPIRY_DAYS=
# RETENTION_DRY_RUN=true — обкатка cleanup-cron'а без реального DROP SCHEMA
RETENTION_DRY_RUN=

# === Trial ===
# Дни пробного периода для новых студий (default 3)
TRIAL_DAYS=

# === Юр. лицо (для ФЗ-152 в политике конфиденциальности) ===
LEGAL_OPERATOR_NAME=          # ФИО самозанятой
LEGAL_OPERATOR_INN=           # ИНН
LEGAL_CONTACT_EMAIL=          # для запросов субъектов ПД
